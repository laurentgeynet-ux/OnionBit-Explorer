    padding: 10px 20px; 
    color: #ffffff; 
    cursor: pointer; 
    z-index: 1; 
    transition: color 0.3s ease; 
}  

.hero_button-r::after {  
    content: ''; 
    position: absolute; 
    left: 0; 
    right: 0;
    bottom: 0; 
    height: 100%; 
    background: linear-gradient(to bottom, transparent 0%, #1f1d5d 130%);  
    opacity: 0; 
    transition: opacity 0.3s ease; 
    z-index: -1; 
}  

.hero_button-r:hover::after {  
    opacity: 1; 
}  


