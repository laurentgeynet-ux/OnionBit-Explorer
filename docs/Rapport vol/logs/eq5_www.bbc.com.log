external\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Read about our approach to external linking.\",\"attributes\":[[\"bold\"]]}}]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\" \",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\" \",\"attributes\":[]}}]}}]"}},"isSubscriptionAllowed":false,"metadata":{},"pageKey":"@\"news\",","page":{"@\"news\",":{"sections":[{"type":"virginia","content":[{"title":"Brazil's left-wing President Lula wins fourth term but rival Flávio Bolsonaro rejects result","href":"https://www.bbc.com/news/live/cmgelnrd4r3jt","isLiveNow":true,"metadata":{"contentType":"live","subtype":"news","lastUpdated":1793142000000,"firstUpdated":1792882800000,"topics":[],"isLiveNow":true},"tags":[],"description":"Lula overturns the outcome from the first round of voting, but Bolsonaro calls the result \"inexplicable\" and refuses to concede.","image":{"type":"indexImage","model":{"blocks":{"src":"https://ichef.bbci.co.uk/ace/standard/480/cpsprodpb/424d/live/d8c74a80-d134-11f1-93e1-3b657b665bcf.jpg","altText":"Lula in a blue shirt surrounded by supporters who are raising their arms in celebration","width":1920,"height":1080}}},"relatedUrls":[],"id":"urn:bbc:tipo:topic:cmgelnrd4r3jt","brandName":"","seriesName":"","seriesId":"","brandId":"","versionId":""},{"title":"Watch: How Lula turned it around to beat former president's son","href":"/news/videos/cmp8g0x4l11yo","isLiveNow":false,"metadata":{"contentType":"video","subtype":"clip news","lastUpdated":1792983180960,"firstUpdated":1792983180960,"topics":["Latin America"]},"tags":[],"description":"Brazil's left-wing President has been elected for a fourth term after narrowly beating right-wing Flávio Bolsonaro in a knife-edge vote.","image":{"type":"indexImage","model":{"blocks":{"src":"https://ichef.bbci.co.uk/news/480/cpsprodpb/3247/live/2f1c2d90-d10a-11f1-b441-2b33b063138f.png","altText":"A split screen of a BBC correspondent speaking into a microphone and Brazil's President Lula","width":976,"height":549}}},"relatedUrls":[],"id":"urn:bbc:optimo:asset:cmp8g0x4l11yo","brandName":"","seriesName":"","seriesId":"","brandId":"","versionId":""},{"title":"Chris Brown given suspended eight-month prison sentence over London nightclub attack","href":"https://www.bbc.com/news/live/c615j0e8ydq1t","isLiveNow":true,"metadata":{"contentType":"live","subtype":"news","lastUpdated":1793089140000,"firstUpdated":1793009460000,"topics":[],"isLiveNow":true},"tags":[],"description":"The judge says Brown's \"repeated use of a glass bottle\" against the victim's head was \"plainly dangerous\". Brown, 37, pleaded guilty in July to a charge of affray.","image":{"type":"indexImage","model":{"blocks":{"src":"https://ichef.bbci.co.uk/ace/standard/480/cpsprodpb/452a/live/fb490870-d137-11f1-be77-d1864d279cb0.jpg","altText":"Chris Brown leaves court wearing a face covering and sunglasses. There are people taking photographs of him","width":3624,"height":2039}}},"relatedUrls":[],"id":"urn:bbc:tipo:topic:c615j0e8ydq1t","brandName":"","seriesName":"","seriesId":"","brandId":"","versionId":""},{"title":"Celebrations in Serbia after veteran ruler Vučić loses election to student-led protest movement","href":"/news/articles/cw5yn3xlprpmo","isLiveNow":false,"metadata":{"contentType":"article","subtype":"news","lastUpdated":1793012540330,"firstUpdated":1792962119019,"topics":["Europe"]},"tags":[],"description":"The populist right-wing leader of 12 years says it is \"clear\" his party has lost the vote billed as a referendum on the country's future.","image":{"type":"indexImage","model":{"blocks":{"src":"https://ichef.bbci.co.uk/news/480/cpsprodpb/f0c7/live/712973e0-d110-11f1-b441-2b33b063138f.jpg","altText":"People wave a Serbian flag at Slavija roundabout in downtown Belgrade, with flare smoke and fireworks in the background against a night sky,  on Sunday.","width":1920,"height":1080}}},"relatedUrls":[],"id":"urn:bbc:optimo:asset:cw5yn3xlprpmo","brandName":"","seriesName":"","seriesId":"","brandId":"","versionId":""},{"title":"Venezuelan opposition leader María Machado returns after months in exile","href":"/news/articles/cq8ez592pp0eo","isLiveNow":false,"metadata":{"contentType":"article","subtype":"news","lastUpdated":1792992019302,"firstUpdated":1792945300228,"topics":["Latin America"]},"tags":[],"description":"Machado had left the country just a month before the US government seized Venezuelan President Nicolás Maduro. ","image":{"type":"indexImage","model":{"blocks":{"src":"https://ichef.bbci.co.uk/news/480/cpsprodpb/4dcf/live/679d8fc0-d0a0-11f1-87fa-c1809f43a7a8.jpg","altText":"A woman in white crosses her arms on her chest with her hands pointed towards her shoulders and her eyes closed","width":923,"height":520}}},"relatedUrls":[],"id":"urn:bbc:optimo:asset:cq8ez592pp0eo","brandName":"","seriesName":"","seriesId":"","brandId":"","versionId":""},{"title":"'I am here. With you': Machado greeted by crowds as she returns to Venezuela","href":"/news/videos/cwgkv8kmly4zo","isLiveNow":false,"metadata":{"contentType":"video","subtype":"clip news","lastUpdated":1793007072373,"firstUpdated":1793007072373,"topics":["Latin America"]},"tags":[],"description":"The Venezuelan opposition leader spent more than 10 months in exile after escaping the country on a speedboat.","image":{"type":"indexImage","model":{"blocks":{"src":"https://ichef.bbci.co.uk/news/480/cpsprodpb/276a/live/9bd2b450-d11d-11f1-a701-fddedf244c16.jpg","altText":"Venezuelan opposition leader Maria Corina Machado greets supporters as she arrives in Caracas","width":1920,"height":1080}}},"relatedUrls":[],"id":"urn:bbc:optimo:asset:cwgkv8kmly4zo","brandName":"","seriesName":"","seriesId":"","brandId":"","versionId":""},{"title":"Eric Bauza, voice of Bugs Bunny and Daffy Duck, dies aged 46","href":"/news/articles/cwzd6q630vjeo","isLiveNow":false,"metadata":{"contentType":"article","subtype":"news","lastUpdated":1792995375893,"firstUpdated":1792995375893,"topics":[]},"tags":[],"description"