.w3-third .bigbtn {
  margin-bottom: 16px;
  width: 100%;
  padding: 20px 0;
  text-align: center;
  vertical-align: middle;
  display: inline-block;
  text-decoration: none !important;
  border-radius: 5px;
}

@media screen and (max-width: 992px) {
  .bigbtn {
    display: block;
    width: 100%;
  }
}

.htmlh2 {
  font-size: 32px;
}

.w3-blue:hover {
  background-color: #0d8bf2 !important
}

/* HTML's cert icon is smaller than the shared default, so header spacing needs to match */
.cert-card-header {
  gap: 16px;
}

.cert-card-icon {
  width: 30px;
  height: 30px;
}

.cert-info-title span {
  color: #04AA6D;
}

.cert-info-price span {
  font-size: 14px;
  font-weight: 400;
  color: #000;
  font-family: 'Source Sans Pro Topnav', sans-serif;
}

.cert-info-btn {
  display: inline-block;
  padding: 12px 28px;
  background: #04AA6D;
  color: #fff;
  text-decoration: none;
  border-radius: 6px;
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 0;
}

.cert-info-btn:hover {
  background: #038857;
}

.cert-preview-img {
  max-width: 100%;
  height: auto;
  border-radius: 8px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.1);
}

@media screen and (max-width: 600px) {
  .cert-bottom-row {
    flex-direction: column;
    align-items: flex-start;
  }
}

body.darkpagetheme .cert-info-price span {
  color: #94a3b8;
}


.html-links {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6px;
  margin-top: 20px;
  margin-left: -20px;
  margin-right: -20px;
  position: relative;
}

.float-or {
  background-color: white;
  color: black;
  position: absolute;
  top: 51%;
  left: 50%;
  padding: 8px;
  border-radius: 8px;
  font-size: 14px;
  border: 1px solid #eee;
  transform: translate(-50%, -50%);
}

.html-card {
  flex: 1 1 350px;
  padding: 28px 20px;
  boxrder-radius: 5px;
  text-decoration: none;
  text-align: center;
  border-radius:6px;
}

.html-card h2 {
  margin-top: 0;
  font-size: 19px;
  font-weight: 550;
  margin-bottom: 12px;
}

.html-card p {
  margin: 0;
  font-size: 16px;
  color: inherit;
}

.html-tutorial {
  background-color: #E6F6F0;
  color: #222;
}

.html-course {
  background-color: #F4EFFE;
  color: black;
}

.html-course .ws-purple:hover {
  background-color: #7d53cc !important;
  color: #fff !important;
}

@media screen and (max-width: 600px) {
  .htmlh2 {
    font-size: 25px;
  }
  .float-or {
  font-size:13px;
}
.html-links {
  margin-left: -16px;
  margin-right: -16px;
}
.html-card {

}
}

body.darkpagetheme .html-tutorial {
 background-color: rgb(21,32,43);
 color:#ddd;
}
body.darkpagetheme .html-course {
 background-color: #243442;
 color:#ddd;
}
body.darkpagetheme  .float-or {
  background-color: #000;
  color:white;
}
