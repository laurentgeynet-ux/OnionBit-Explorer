|               <script>
|                 "
(function () {
  var currentUrl = new URL(window.location.href);
  var currentPath = currentUrl.pathname.toLowerCase();
  var currentTopic = currentUrl.searchParams.get("topic") || "";
  var currentX = currentUrl.searchParams.get("x") || "1";
  var isEmbedPage = currentPath.indexOf("html_exercise_embed.asp") > -1;

  function parseLink(link) {
    var url = new URL(link.href, window.location.origin);
    return {
      path: url.pathname.toLowerCase(),
      topic: url.searchParams.get("topic") || "",
      x: url.searchParams.get("x") || "1"
    };
  }

  function updateExerciseOverviews() {
    var overviews = document.querySelectorAll(".tut_overview");

    for (var i = 0; i < overviews.length; i++) {
      var overview = overviews[i];
      var stepLinks = overview.querySelectorAll(".step_link");
      var allLinks = overview.querySelectorAll("a");
      var headerLink = overview.previousElementSibling;
      var isCurrentOverview = false;

      overview.classList.remove("is-current");
      overview.style.display = "";

      for (var j = 0; j < stepLinks.length; j++) {
        stepLinks[j].classList.remove("active");
      }

      if (headerLink) {
        headerLink.classList.remove("active");
        headerLink.classList.remove("active_overview");
        headerLink.classList.remove("active-links-present");
        headerLink.classList.remove("activesub");
      }

      for (var j = 0; j < allLinks.length; j++) {
        var link = allLinks[j];
        var linkInfo = parseLink(link);
        var matched = false;

        if (link.classList.contains("step_link")) {
          if (isEmbedPage) {
            // Check if link has x parameter
            var linkHasX = link.getAttribute("href").indexOf("&x=") > -1;
            if (linkHasX) {
              // Numbered exercise link - match exact exercise
              if (
                linkInfo.path === currentPath &&
                linkInfo.topic === currentTopic &&
                linkInfo.x === currentX
              ) {
                matched = true;
                link.classList.add("active");
              }
            } else {
              // Simplified Exercises link (no x) - match any exercise in topic
              if (
                linkInfo.path === currentPath &&
                linkInfo.topic === currentTopic
              ) {
                matched = true;
                link.classList.add("active");
              }
            }
          } else {
            if (linkInfo.path === currentPath) {
              matched = true;
              link.classList.add("active");
            }
          }
        } else {
          if (linkInfo.path === currentPath && !isEmbedPage) {
            matched = true;
          } else if (isEmbedPage && linkInfo.topic === currentTopic && linkInfo.path === currentPath) {
            matched = true;
          }
        }

        if (matched) {
          isCurrentOverview = true;
          break;
        }
      }

      if (!isCurrentOverview && isEmbedPage) {
        var overviewStepLinks = overview.querySelectorAll(".step_link");
        for (var k = 0; k < overviewStepLinks.length; k++) {
          var slInfo = parseLink(overviewStepLinks[k]);
          if (slInfo.topic === currentTopic) {
            isCurrentOverview = true;
            break;
          }
        }
      }

      if (isCurrentOverview) {
        overview.classList.add("is-current");
        overview.style.display = "block";

        if (headerLink) {
          headerLink.classList.add("active");
          headerLink.classList.add("active_overview");
          headerLink.classList.add("active-links-present");
        }
      }
    }
  }

  function runAndScroll() {
    updateExerciseOverviews();
    if (typeof sidemenuitemintoview === "function") {
      sidemenuitemintoview();
    }
  }

  function init() {
    runAndScroll();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
