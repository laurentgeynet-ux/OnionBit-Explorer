@font-face {
  font-family: "PS2P";
  src: url("/adventure/fonts/ps2p-caps.woff2") format("woff2");
  font-display: block;
}
.quest-nextprev {
  text-align: center;
}
.nextprev a.quest-entry:link,
.nextprev a.quest-entry:visited {
  position: relative;
  display: inline-block;
  height: 44px;
  padding: 0 24px;
  border: 2px solid #a3cffb;
  border-radius: 0;
  background-color: #dfeefe;
  color: #292524;
  box-shadow: 0 8px 0 -4px #000000;
  font-family: "PS2P", monospace;
  font-size: 10px;
  line-height: 40px;
  text-transform: uppercase;
  text-decoration: none;
  white-space: nowrap;
}
.nextprev a.quest-entry:hover {
  background-color: #d1e7fd;
  border-color: #04aa6d;
}
.nextprev a.quest-entry:active {
  transform: translateY(2px);
  box-shadow: 0 6px 0 -4px #000000;
}
.nextprev a.quest-entry:focus {
  background-color: #dfeefe !important;
  box-shadow: 0 8px 0 -4px #000000;
  outline: 2px solid #04aa6d;
  outline-offset: 2px;
}
.nextprev a.quest-entry:focus:not(:focus-visible) {
  outline: none;
}
.quest-entry-lynx {
  position: absolute;
  left: 50%;
  bottom: 100%;
  width: 51px;
  height: 8px;
  margin: 0 0 2px -26px;
  background: url("/adventure/img/demo/lynx.png") no-repeat 0 0;
  image-rendering: pixelated;
  pointer-events: none;
  transition: height 0.15s ease-out;
}
.nextprev a.quest-entry:hover .quest-entry-lynx,
.nextprev a.quest-entry:focus .quest-entry-lynx {
  height: 38px;
}
@media (prefers-reduced-motion: reduce) {
  .quest-entry-lynx {
    transition: none;
  }
}
.quest-entry::after {
  content: "";
  position: absolute;
  right: 4px;
  bottom: 8px;
  width: 2px;
  height: 2px;
  background-color: currentColor;
  box-shadow: -2px 2px, 0 2px, -4px 4px, -2px 4px, 0 4px;
}
@media (max-width: 600px) {
  .quest-nextprev {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .quest-nextprev::before,
  .quest-nextprev::after {
    display: none;
  }
  .nextprev a.quest-entry {
    order: 1;
    width: 100%;
    margin-top: 16px;
  }
}
html.quest-signed-in .nextprev a.quest-entry,
body.w3s-user-authenticated .nextprev a.quest-entry {
  display: none;
}
html.quest-signed-in body.w3s-user-anonymous .nextprev a.quest-entry {
  display: inline-block;
}
html.quest-pixel-in {
  background-color: #292524;
}
html.quest-pixel-in body {
  visibility: hidden;
}
