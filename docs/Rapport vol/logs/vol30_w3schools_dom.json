try {
  if (sessionStorage.getItem("quest-pixel-in")) {
    document.documentElement.className += " quest-pixel-in";
    setTimeout(function () {
      document.documentElement.className = document.documentElement.className.replace(/\s*quest-pixel-in/g, "");
    }, 3000);
  }
} catch (e) {}
try {
  if (typeof upack === "function" && upack()) {
    document.documentElement.className += " quest-signed-in";
  } else {
    var questFont = document.createElement("link");
    questFont.rel = "preload";
    questFont.as = "font";
    questFont.type = "font/woff2";
    questFont.crossOrigin = "anonymous";
    questFont.href = "/adventure/fonts/ps2p-caps.woff2";
    document.head.appendChild(questFont);
  }
} catch (e) {}
