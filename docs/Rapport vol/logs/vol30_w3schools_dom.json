|               <script>
|                 "
/* One delegated listener for every bar on the page, bound once even if the
   include is pulled in twice. The markup above is static, so the bar is part of
   the cached HTML and needs no script to appear - this only wires the clicks. */
(function(){
  if(window.wsShareBar)return;
  window.wsShareBar=1;
  function pageUrl(){return location.href.split('#')[0];}
  document.addEventListener('click',function(e){
    var btn=e.target&&e.target.closest?e.target.closest('.ws-share-btn'):null;
    if(!btn)return;
    var net=btn.getAttribute('data-ws-net');
    if(net==='copy'){
      if(!navigator.clipboard)return;
      var toast=btn.querySelector('.ws-copied-toast');
      navigator.clipboard.writeText(pageUrl()).then(function(){
        btn.classList.add('copied');
        if(toast)toast.classList.add('show');
        clearTimeout(btn._wsT);
        btn._wsT=setTimeout(function(){
          btn.classList.remove('copied');
          if(toast)toast.classList.remove('show');
        },1600);
      });
      return;
    }
    var url=encodeURIComponent(pageUrl()),s='';
    if(net==='x'){
      var title=document.title.replace(/\s*[-|]\s*W3Schools.*$/i,'').trim();
      s='https://twitter.com/intent/tweet?url='+url+'&text='+encodeURIComponent(title+' - W3Schools');
    }
    else if(net==='facebook')s='https://www.facebook.com/sharer/sharer.php?u='+url;
    else if(net==='linkedin')s='https://www.linkedin.com/sharing/share-offsite/?url='+url;
    if(s)window.open(s,'_blank','noopener,width=600,height=540');
  });
})();
