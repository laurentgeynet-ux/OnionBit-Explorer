    color = topColor1;
    // #8a90e1
    vec3 topColor2 = vec3(138.0/255.0, 144.0/255.0, 225.0/255.0);
    color = mix(color, topColor2, topY);


  float bottomY = smoothstep(-2.0, -0.2, vPosition.y);
    // bottom color #421782
    vec3 bottomColor = vec3(66.0/255.0, 23.0/255.0, 130.0/255.0);
    color = mix(bottomColor, color, bottomY);
  #endif

  gl_FragColor = vec4(color, 1.0);
}
