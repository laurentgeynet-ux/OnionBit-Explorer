uniform vec3 uBaseColor;
uniform vec2 uResolution;
uniform float uTime;

varying vec2 vUv;
varying vec3 vNormal;
varying vec3 vNormal2;
varying vec3 vPosition;
varying vec3 vWorldPosition;

float getFresnel(vec3 normal, float power) {
  vec3 viewDir = vec3(0.0, -0.5, 1.0);
  return 1.0 - pow(max(dot(viewDir, normal), 0.0), power);
}

void main(){
  vec3 color = vNormal2 * 0.5 + 0.5;
  vec2 fragCoord = gl_FragCoord.xy / uResolution;


  #if defined(MONA_COLOR_BLACK) || !defined(IS_BODY_COLOR)
    color = uBaseColor;
    color = pow(color, vec3(1.0/2.2));
  #endif


  #if defined(MONA_COLOR_PEARL) && defined(IS_BODY_COLOR)
    color = vec3(fragCoord, 1.0);
    float s = sin(fragCoord.x * 3.0 + fragCoord.y * 3.0) * 0.5 + 0.5;

    s *= s;

    vec3 yellow = vec3(250.0/255.0, 255.0/255.0, 171.0/255.0);

    color = mix(color, yellow,  s * 0.5);

    color = pow(color, vec3(1.0/2.2));
