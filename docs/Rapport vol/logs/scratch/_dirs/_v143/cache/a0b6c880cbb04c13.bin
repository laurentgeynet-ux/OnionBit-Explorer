  hsv.g -= rainbowFactor.y * 0.1;
  hsv.b += rainbowFactor.y * 0.2;

  #ifndef IS_GLASS_RENDER
  ${o.A}
  #endif

  rainbowColor = hsv2rgb(hsv);
