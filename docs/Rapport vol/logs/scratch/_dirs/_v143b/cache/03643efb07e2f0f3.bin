<!DOCTYPE html>
<html>
  <head>
    <title>© 2026 Adobe. All Rights Reserved.</title>
    <link rel="canonical" href="https://spectrum.adobe.com/fragments/nav/footer">
    <meta property="og:title" content="© 2026 Adobe. All Rights Reserved.">
    <meta property="og:url" content="https://spectrum.adobe.com/fragments/nav/footer">
    <meta property="og:image" content="https://spectrum.adobe.com/media_1270372ba73a31b64cb998d3c4a0a3d44e565196f.png">
    <meta property="og:image:secure_url" content="https://spectrum.adobe.com/media_1270372ba73a31b64cb998d3c4a0a3d44e565196f.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="© 2026 Adobe. All Rights Reserved.">
    <meta name="twitter:image" content="https://spectrum.adobe.com/media_1270372ba73a31b64cb998d3c4a0a3d44e565196f.png">
    <meta name="light-bg" content="/media/beta/f7f7f7.svg">
    <meta name="dark-bg" content="/media/beta/media_1c0a4e1dfd78aa42403b402b32002d53a8bb904eb.png">
    <meta name="robots" content="noindex, nofollow">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/styles/styles.css">
    <script nonce="aem" type="importmap">
      { "imports": { "lit": "/deps/lit/dist/index.js" } }
    </script>
    <script src="/scripts/ak.js" type="module"></script>
    <script src="/scripts/scripts.js" type="module"></script>
    <link rel="icon" href="data:,">
    <script nonce="aem">
      window.addEventListener('pagereveal', async ({ viewTransition: vt }) => {
        const postLcpReady = () => {
          const section = document.querySelector('main > .section');
          const header = document.querySelector('header');
          return section && !section.dataset.status && (!header || header.querySelector('.header-content'));
        };
        if (!vt || await vt.ready.then(postLcpReady, () => true)) return;
        const anims = document.getAnimations().filter((a) => a.effect?.pseudoElement?.startsWith('::view-transition'));
        anims.forEach((a) => a.pause());
        const start = performance.now();
        (function check() {
          if (postLcpReady() || performance.now() - start > 3000) anims.forEach((a) => a.play());
          else requestAnimationFrame(check);
        }());
      });
    </script>
  </head>
  <body>
    <header></header>
    <main>
      <div>
        <ul>
          <li>© 2026 Adobe. All Rights Reserved.</li>
          <li><a href="https://www.adobe.com/legal/terms.html">Terms of Use</a></li>
          <li><a href="https://www.adobe.com/privacy.html">Privacy Policy</a></li>
        </ul>
      </div>
    </main>
    <footer></footer>
  </body>
</html>
