ww.ikea.com/ext/ingkadam/m/547cddc6b1832981/original/PE660381.jpg?f=xxxs"}],"type":"slideData","contentType":"pointer"}],"title":"Rappel de produits","contentId":"4JiXNjFvW3cH2vTVkz5QDh"}},"2":{"loaderData":{"siteFolder":"fr/fr","data":[{"title":"Contactez-nous","description":"Vous trouverez de nombreuses réponses en ligne, mais le centre de support clients est aussi à votre disposition pour répondre par chat, mail ou téléphone.","url":"https://www.ikea.com/fr/fr/customer-service/contact-us/","image":{"title":"Pictogramme illustrant une bulle de chat.","url":"https://www.ikea.com/images/pictogramme-illustrant-une-bulle-de-chat-62d6dbc7b01bd4302d217bcb90550dc7.jpg"}},{"title":"App IKEA","description":"Trouvez de l’inspiration, explorez des offres et des bons plans sur mesure, visualisez l’espace de vos rêves.​ Rejoignez les plus de 100 millions de personnes qui utilisent et aiment l’application IKEA !","url":"https://www.ikea.com/fr/fr/customer-service/mobile-apps/","image":{"title":"Personne en train de boire un café. ","url":"https://www.ikea.com/ext/ingkadam/m/4cdf56d5046a0988/original/IKEA__app_Cafe_1_1x1.jpg"}},{"title":"Modalités de paiement","description":"Retrouvez l'ensemble de nos modes et modalités de paiement en ligne et en magasin. ","url":"https://www.ikea.com/fr/fr/customer-service/payment-options/","image":{"title":"Cash machine with money","url":"https://www.ikea.com/images/cash-machine-with-money-5127c43c286ff64a4d6e942b7bd38d24.jpg"}},{"title":"Support produits","description":"Besoin d'aide pour un de nos produits? Rendez-vous sur nos pages Support produits ou Assistance produits. Vous trouverez de l'aide pour faire fonctionner vos produits connectés, des infos sur le retour produits, le sav électroménager, les garanties, la commande de pièces détachées... ","url":"https://www.ikea.com/fr/fr/customer-service/product-support/","image":{"title":"Main posant un téléphone mobile sur un chargeur sans fil installé sur un meuble.","url":"https://www.ikea.com/images/main-posant-un-telephone-mobile-sur-un-chargeur-sans-fil-ins-e256056ec1c0a889a4550d220932cef7.jpg"}},{"title":"Conditions de retour","description":"Découvrez à quel point il est facile de changer d’avis et de nous retourner un produit chez IKEA – en magasin, par la poste ou par enlèvement.","url":"https://www.ikea.com/fr/fr/customer-service/returns-claims/","image":{"title":"Une collaboratrice du Service clientèle IKEA travaillant à son bureau.","url":"https://www.ikea.com/images/une-collaboratrice-du-service-clientele-ikea-travaillant-a-s-6f113d653ea6b30defc5b49db10b48aa.jpg"}},{"title":"Comment acheter chez IKEA ?","description":"Il y a plusieurs façons de faire ses achats chez IKEA : de l’achat en ligne à la planification à distance, Plusieurs solutions s'offrent à vous !","url":"https://www.ikea.com/fr/fr/customer-service/shopping-at-ikea/","image":{"title":"Un sac bleu rempli d'achats IKEA sur un buffet à côté d'articles IKEA","url":"https://www.ikea.com/ext/ingkadam/m/5cd5430e8f0872e5/original/PH188794-crop002.jpg"}},{"title":"Disponibilité de nos produits","description":"Vérifiez en ligne l'état des stocks et la disponibilité des produits avant de vous rendre en magasin IKEA. Nous mettons régulièrement à jour ces informations.","url":"https://www.ikea.com/fr/fr/customer-service/stock-availability/","image":{"title":"Disponibilité des articles","url":"https://www.ikea.com/images/disponibilite-des-articles-64afaa050119858d0d0b3f7688f0ede5.jpg"}},{"title":"Suivi et gestion de commande","description":"Avec votre numéro de commande à 9 chiffres, suivez votre livraison en ligne ou demandez un changement de date.","url":"https://www.ikea.com/fr/fr/customer-service/track-manage-order/","image":{"title":"picto suivi de commande IKEA","url":"https://www.ikea.com/images/picto-suivi-de-commande-ikea-d3116782f7ffd66217300fb5a220f396.jpg"}}],"translations":{"T_ARIA_PAUSE_VIDEO":"Mettre la vidéo en pause","T_ARIA_PLAY_VIDEO":"Lire la vidéo","T_CAROUSEL_ARIA_LABEL