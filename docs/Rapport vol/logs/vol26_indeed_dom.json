    font-family: "Noto Sans", "Helvetica Neue", Helvetica, Arial, "Liberation Sans", Roboto, Noto, sans-serif !important;
    background-color: rgb(237, 241, 255) !important; 
}

#onetrust-banner-sdk #onetrust-policy-text {
    font-style: normal !important;
    font-weight: 400 !important;
    font-size: 14px !important;
    line-height: 150%;
    color: #2D2D2D;;
}

#onetrust-button-group button {
    font-style: normal !important;
    font-weight: 600 !important;
    font-size: 16px !important;
    color: #FFFFFF !important;
    border-radius: .5rem;
    background-color: #2557A7;
    padding: 12px 16px !important;
    border: .0625rem solid transparent;
}

#onetrust-button-group button:hover {
    background-color: #164081;
    opacity: 1;
}
#onetrust-button-group button:focus {
    box-shadow: 0 0 0 2px #fff,0 0 0 3px #2557A7;
    outline: none;
    transition: box-shadow .2s linear;
    opacity: 1;
}

#onetrust-banner-sdk #onetrust-policy-text a {
     margin-left: 0px !important;
}

@media only screen and (min-width: 897px) and (max-width: 1350px) {

 #onetrust-group-container {
    width: calc(100% - 560px) !important;
 }

 #onetrust-button-group-parent {
    width: 590px !important;
 }

 #onetrust-banner-sdk.vertical-align-content #onetrust-button-group-parent {
    left: unset !important;
    transform: translateY(-50%) !important;
    float: unset;
    margin: auto;
 }

 #onetrust-banner-sdk #onetrust-button-group {
    margin-right: 0 !important;
 }
