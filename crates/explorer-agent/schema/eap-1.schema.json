{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://explorer.local/schema/eap-1.schema.json",
  "title": "EAP v1 — Explorer Agent Protocol",
  "description": "Contrat de la surface agent (ADR-0035). Transport : WebSocket GET /agent, sous-protocole eap/1. Trames texte = JSON-RPC 2.0 (id présent = requête, absent = notification). Trames binaires = réponses à charge lourde : [u32 LE id][u32 LE kind][payload] — kind 1 = image/png. Chaque méthode porte x-phase : la phase de livraison (E1..E4) — une méthode non encore implémentée répond légalement error.code -32001 (unsupported).",

  "$defs": {
    "jsonrpc": { "const": "2.0" },
    "id": { "type": ["integer", "string"] },
    "tabId": { "type": "integer", "minimum": 0 },
    "elementRef": { "type": "string", "pattern": "^el:[0-9]+$", "description": "Handle opaque alloué par la table serveur — expire en stale_ref" },
    "rev": { "type": "integer", "minimum": 0, "description": "Compteur monotone de document commis, par onglet" },

    "rect": {
      "type": "object",
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" },
        "w": { "type": "number" }, "h": { "type": "number" }
      },
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false
    },

    "keyMods": {
      "type": "object",
      "properties": {
        "ctrl": { "type": "boolean", "default": false },
        "shift": { "type": "boolean", "default": false },
        "alt": { "type": "boolean", "default": false },
        "meta": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },

    "capability": {
      "type": "string",
      "enum": [
        "snapshot", "snapshot_diff", "handles", "actionable",
        "wait_commit", "input", "eval", "frames",
        "console_log", "dom", "tabs", "events", "engine"
      ]
    },

    "tabScope": {
      "description": "all (chaîne) ou liste d'onglets",
      "oneOf": [
        { "const": "all" },
        { "type": "array", "items": { "$ref": "#/$defs/tabId" } }
      ]
    },

    "profile": {
      "type": "object",
      "description": "Droits de session demandés — le serveur accorde au plus ce qui est demandé",
      "properties": {
        "input": { "type": "boolean", "default": false, "description": "droit aux actions input.* — défaut lecture seule" },
        "eval": { "type": "boolean", "default": false, "description": "droit à eval.run — exécution arbitraire" },
        "tabs": { "$ref": "#/$defs/tabScope", "default": "all" }
      },
      "additionalProperties": false
    },

    "check": {
      "type": "string",
      "enum": ["visible", "stable", "enabled", "topmost"],
      "description": "visible = style calculé + boîte posée non vide ; stable = rect identique sur deux commits layout ; enabled = ni disabled ni inert hérité ; topmost = hit-test au centre retombe sur l'élément"
    },

    "actionOpts": {
      "type": "object",
      "properties": {
        "require": { "type": "array", "items": { "$ref": "#/$defs/check" }, "default": ["visible", "stable", "enabled", "topmost"] },
        "timeout_ms": { "type": "integer", "minimum": 0 },
        "force": { "type": "boolean", "default": false, "description": "agir au dernier rect connu — résultat marqué degraded" }
      },
      "additionalProperties": false
    },

    "actionability": {
      "type": "object",
      "properties": {
        "visible": { "type": "boolean" }, "stable": { "type": "boolean" },
        "enabled": { "type": "boolean" }, "topmost": { "type": "boolean" }
      },
      "required": ["visible", "stable", "enabled", "topmost"],
      "additionalProperties": false
    },

    "waitKind": {
      "type": "string",
      "enum": ["commit", "idle", "frame", "selector", "stable", "network_idle"]
    },

    "role": {
      "description": "Sous-ensemble énuméré ou chaîne libre (rôles hors mapping v1)",
      "oneOf": [
        { "type": "string", "enum": ["link", "button", "textbox", "checkbox", "radio", "heading", "img", "navigation", "form", "combobox", "list_item", "table", "main", "generic"] },
        { "type": "string" }
      ]
    },

    "nodeState": {
      "type": "string",
      "enum": ["focus", "disabled", "checked", "expanded", "editable", "link", "selected", "required"]
    },

    "snapshotNode": {
      "type": "object",
      "properties": {
        "ref": { "$ref": "#/$defs/elementRef" },
        "role": { "$ref": "#/$defs/role" },
        "name": { "type": "string", "description": "nom accessible, borné 120 chars" },
        "states": { "type": "array", "items": { "$ref": "#/$defs/nodeState" } },
        "rect": { "$ref": "#/$defs/rect", "description": "px CSS viewport — absent si non posé" },
        "depth": { "type": "integer", "minimum": 0, "description": "profondeur pré-ordre document" }
      },
      "required": ["ref", "role", "name", "depth"],
      "additionalProperties": false
    },

    "eventKind": {
      "type": "string",
      "enum": ["nav", "frame", "console_log", "snapshot", "tabs", "download"]
    },

    "rpcError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "enum": [-32700, -32601, -32602, -32001, -32002, -32003, -32004, -32005, -32006, -32007, -32008],
          "description": "-32700 parse · -32601 method_not_found · -32602 invalid_params · -32001 unsupported · -32002 stale_ref · -32003 not_actionable · -32004 timeout · -32005 no_such_tab · -32006 bad_selector · -32007 engine_unavailable · -32008 unauthorized"
        },
        "message": { "type": "string" },
        "data": { "description": "détail typé — ex. actionability sous -32003" }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    }
  },

  "x-methods": {
    "session.open": {
      "x-phase": "E1",
      "description": "Première requête obligatoire — négocie protocole, capacités et droits.",
      "params": {
        "type": "object",
        "properties": {
          "protocol": { "const": "eap/1" },
          "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "description": "absent = toutes les capacités livrées" },
          "profile": { "$ref": "#/$defs/profile" }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "protocol": { "const": "eap/1" },
          "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "description": "capacités livrées = demandées ∩ implémentées" },
          "profile": { "$ref": "#/$defs/profile", "description": "droits accordés" },
          "help": { "type": "object", "description": "index compact question→verbe(s), filtré par les capacités livrées (étape 248)", "additionalProperties": { "type": "string" } }
        },
        "required": ["protocol", "capabilities", "profile"]
      }
    },

    "session.close": { "x-phase": "E1", "params": { "type": "object" }, "result": { "type": "object" } },
    "session.ping": { "x-phase": "E1", "params": { "type": "object" }, "result": { "type": "object", "properties": { "ts_ms": { "type": "integer" } } } },

    "tab.open": {
      "x-phase": "E1",
      "params": { "type": "object" },
      "result": { "type": "object", "properties": { "tab": { "$ref": "#/$defs/tabId" } }, "required": ["tab"] }
    },
    "tab.close": {
      "x-phase": "E1",
      "params": { "type": "object", "properties": { "tab": { "$ref": "#/$defs/tabId" } }, "required": ["tab"], "additionalProperties": false },
      "result": { "type": "object" }
    },
    "tab.list": {
      "x-phase": "E1",
      "params": { "type": "object" },
      "result": {
        "type": "object",
        "properties": {
          "tabs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tab": { "$ref": "#/$defs/tabId" },
                "url": { "type": ["string", "null"] },
                "title": { "type": ["string", "null"] },
                "scroll_y": { "type": "number" }
              },
              "required": ["tab", "url", "title", "scroll_y"]
            }
          }
        },
        "required": ["tabs"]
      }
    },

    "nav.goto": {
      "x-phase": "E1",
      "description": "Répond au commit nav.committed (ou wait plus lâche / Timeout).",
      "params": {
        "type": "object",
        "properties": {
          "tab": { "$ref": "#/$defs/tabId" },
          "url": { "type": "string" },
          "wait": { "$ref": "#/$defs/waitKind", "default": "commit" },
          "timeout_ms": { "type": "integer", "minimum": 0 }
        },
        "required": ["tab", "url"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "description": "URL finale post-redirections" },
          "title": { "type": ["string", "null"] },
          "rev": { "$ref": "#/$defs/rev" }
        },
        "required": ["url", "title", "rev"]
      }
    },
    "nav.reload": { "x-phase": "E1", "params": { "$ref": "#/$defs/waitParams" }, "result": { "$ref": "#/$defs/navResult" } },
    "nav.back": { "x-phase": "E1", "params": { "$ref": "#/$defs/waitParams" }, "result": { "$ref": "#/$defs/navResult" } },
    "nav.forward": { "x-phase": "E1", "params": { "$ref": "#/$defs/waitParams" }, "result": { "$ref": "#/$defs/navResult" } },
    "nav.viewport": {
      "x-phase": "E1",
      "params": {
        "type": "object",
        "properties": {
          "tab": { "$ref": "#/$defs/tabId" },
          "w": { "type": "integer", "minimum": 1 },
          "h": { "type": "integer", "minimum": 1 },
          "scale": { "type": "number" }
        },
        "required": ["tab", "w", "h"],
        "additionalProperties": false
      },
      "result": { "type": "object" }
    },

    "snapshot.get": {
      "x-phase": "E1 (arbre sérialisé) / E3 (sémantique + diff) / E5 (historique borné, étape 254)",
      "description": "sans since/since_seq : snapshot complet ; avec since : diff contre la dernière émission à cette révision ; avec since_seq (prime sur since) : diff contre l'émission exacte — nécessaire quand deux émissions partagent la même rev (params différents). Chaque réponse porte `snap_seq` (séquence d'émission monotone par connexion) — c'est la valeur à repasser en since_seq. Historique retenu : 8 dernières émissions par onglet et par connexion ; base élaguée → dégradation en snapshot complet honnête, jamais d'erreur.",
      "params": {
        "type": "object",
        "properties": {
          "tab": { "$ref": "#/$defs/tabId" },
          "since": { "$ref": "#/$defs/rev" },
          "since_seq": { "type": "integer", "minimum": 0 },
          "interactive_only": { "type": "boolean", "default": true },
          "max_nodes": { "type": "integer", "minimum": 1 }
        },
        "required": ["tab"],
        "additionalProperties": false
      },
      "result": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "rev": { "$ref": "#/$defs/rev" },
              "snap_seq": { "type": "integer" },
              "stale_since": { "type": "boolean", "description": "étape 257 — true quand since/since_seq était fourni mais la base est absente ou élaguée : ce plein snapshot n'est PAS un diff" },
              "url": { "type": "string" },
              "nodes": { "type": "array", "items": { "$ref": "#/$defs/snapshotNode" } }
            },
            "required": ["rev", "snap_seq", "url", "nodes"]
          },
          {
            "type": "object",
            "properties": {
              "rev": { "$ref": "#/$defs/rev" },
              "base_rev": { "$ref": "#/$defs/rev" },
              "base_seq": { "type": "integer" },
              "snap_seq": { "type": "integer" },
              "added": { "type": "array", "items": { "$ref": "#/$defs/snapshotNode" } },
              "removed": { "type": "array", "items": { "$ref": "#/$defs/elementRef" } },
              "changed": { "type": "array", "items": { "$ref": "#/$defs/snapshotNode" } }
            },
            "required": ["rev", "base_rev", "base_seq", "snap_seq", "added", "removed", "changed"]
          }
        ]
      }
    },

    "query.select": {
      "x-phase": "E2",
      "description": "Sous-ensemble CSS v1 : type, .cls, #id, [attr], [attr=v], combinateurs descendant/enfant. Hors grammaire → -32006.",
      "params": {
        "type": "object",
        "properties": {
          "tab": { "$ref": "#/$defs/tabId" },
          "selector": { "type": "string" },
          "max": { "type": "integer", "minimum": 1 }
        },
        "required": ["tab", "selector"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": { "refs": { "type": "array", "items": { "$ref": "#/$defs/elementRef" } } },
        "required": ["refs"]
      }
    },

    "frame.get": {
      "x-phase": "E1",
      "description": "La réponse est une TRAME BINAIRE [u32 id][u32 kind=1][png] corrélée à id — pas de result JSON. Étape 257 : un raster en vol n'est plus une erreur immédiate — le verbe attend ~2 s (pattern snapshot), -32007 au-delà.",
      "params": {
        "type": "object",
        "properties": {
          "tab": { "$ref": "#/$defs/tabId" },
          "clip": { "$ref": "#/$defs/rect" },
          "full": { "type": "boolean", "default": false }
        },
        "required": ["tab"],
        "additionalProperties": false
      },
      "result": { "description": "trame binaire, hors JSON-RPC" }
    },

    "console.get": {
      "x-phase": "E1",
      "params": {
        "type": "object",
        "properties": {
          "tab": { "$ref": "#/$defs/tabId" },
          "limit": { "type": "integer", "minimum": 1, "default": 512 }
        },
        "required": ["tab"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": { "entries": { "type": "array", "items": { "type": "string" } } },
        "required": ["entries"]
      }
    },

    "dom.get": {
      "x-phase": "E1",
      "description": "DOM sérialisé vivant — échappatoire debug, coûteux en tokens.",
      "params": { "type": "object", "properties": { "tab": { "$ref": "#/$defs/tabId" } }, "required": ["tab"], "additionalProperties": false },
      "result": { "type": "object", "properties": { "html": { "type": "string" } }, "required": ["html"] }
    },
    "engine.layout": {
      "x-phase": "E5",
      "description": "Arbre de boîtes posé (dump diagnostic natif du layout) — introspection moteur.",
      "params": { "type": "object", "properties": { "tab": { "$ref": "#/$defs/tabId" } }, "required": ["tab"], "additionalProperties": false },
      "result": { "type": "object", "properties": { "dump": { "type": "string" } }, "required": ["dump"] }
    },
    "engine.anomalies": {
      "x-phase": "E5",
      "description": "Suspects heuristiques bornés (interactif sans boîte, quasi-invisible, hors document, imbrication pathologique, erreurs pipeline, santé moteur) — indices classés, pas verdicts.",
      "params": { "type": "object", "properties": { "tab": { "$ref": "#/$defs/tabId" }, "max": { "type": "integer", "default": 20 } }, "required": ["tab"], "additionalProperties": false },
      "result": { "type": "object", "properties": { "suspects": { "type": "array", "items": { "type": "object" } }, "scanned": { "type": "object" }, "rev": { "type": "integer" } }, "required": ["suspects", "scanned"] }
    },
    "engine.j17": {
      "x-phase": "E5",
      "description": "Snapshot cumulatif des compteurs J17 d'explorer-jscore (étape 255) — prop_ns/env_ns/rabs_*/eval:*/stmt:* etc. **process-wide** : les compteurs sont des statiques globales du moteur JS, le paramètre `tab` ne sert que le contrat de scope. `armed:false` = EXPLORER_J17_PROF/j17_enable désarmé (snapshot vide, jamais de valeur factice). Cumulatif : la différence de deux snapshots attribue l'intervalle (convention js_alloc), pas de reset.",
      "params": { "type": "object", "properties": { "tab": { "$ref": "#/$defs/tabId" } }, "required": ["tab"], "additionalProperties": false },
      "result": { "type": "object", "properties": { "armed": { "type": "boolean" }, "snapshot": { "type": "string" }, "note": { "type": "string" } }, "required": ["armed", "snapshot"] }
    },
    "engine.pipeline": {
      "x-phase": "E5",
      "description": "Rapport moteur de l'onglet : état de session (époques, presence DOM/layout/frame), compteurs de vie (journal, applies, paint en vol), attribution mémoire par réservoir, livre de phases sync_profile {n,us_total,us_last,us_max,alloc_b,alloc_n} — allocs process pendant la phase. reset:true = sémantique « take » (l'intervalle se clore dans la réponse, le livre repart à zéro).",
      "params": { "type": "object", "properties": { "tab": { "$ref": "#/$defs/tabId" }, "reset": { "type": "boolean", "default": false } }, "required": ["tab"], "additionalProperties": false },
      "result": { "type": "object", "properties": { "state": { "type": "object" }, "counters": { "type": "object" }, "mem": { "type": ["object", "null"] }, "phases": { "type": "object" } }, "required": ["state", "counters"] }
    },
    "engine.paint_stats": {
      "x-phase": "E5",
      "description": "Compteurs du **dernier paint commis** : `emit` = compteurs d'émission boîte→item (EmitStats — boîtes visitées, items par variante, tueurs opacity/backface/visibility, reports, glyphes) ; `raster` = compteurs de replay (ReplayStats R-300 — items scannés, draws/skips, µs par famille text/fill/shadow/img/other) ; `frame` = items de la liste, reports droppés, mode fenêtré. `emit`/`raster` null avant le premier paint ou pendant une passe détachée.",
      "params": { "type": "object", "properties": { "tab": { "$ref": "#/$defs/tabId" } }, "required": ["tab"], "additionalProperties": false },
      "result": { "type": "object", "properties": { "emit": { "type": ["object", "null"] }, "raster": { "type": ["object", "null"] }, "frame": { "type": "object" } }, "required": ["emit", "raster", "frame"] }
    },

    "net.events": {
      "x-phase": "E5",
      "description": "Complétions réseau de l'onglet (étape 251) — ring borné de 512 records à séquence **monotone** : `{seq, kind, url, initiator, status, bytes, ms, from_cache}`. `kind` ∈ document|stylesheet|script|img|iframe|font|module|import|fetch ; `initiator` ∈ navigation|document|stylesheet|element|script|module. Couvre navigation, vague de sous-ressources, fetches dynamiques (script/frame/img/link/module/lazy), `fetch()`/XHR et import de modules — une ligne par complétion réelle (échecs inclus : `status`/`bytes`/`from_cache` à 0/0/false sur échec transport, `from_cache` = service cache local). `ms` = spawn→complétion. Passez `since_seq` (dernier `seq` vu) pour un polling incrémental : `next_seq` de la réponse est le curseur suivant ; les events plus anciens que le premier `seq` rendu ont pu être élagués. Hors borne v1 : corps des réponses, en-têtes, timing détaillé, fetch des téléchargements bufferisés.",
      "params": { "type": "object", "properties": { "tab": { "$ref": "#/$defs/tabId" }, "since_seq": { "type": "integer", "minimum": 0 } }, "required": ["tab"], "additionalProperties": false },
      "result": { "type": "object", "properties": { "events": { "type": "array", "items": { "type": "object", "properties": { "seq": { "type": "integer" }, "kind": { "type": "string" }, "url": { "type": "string" }, "initiator": { "type": "string" }, "status": { "type": "integer" }, "bytes": { "type": "integer" }, "ms": { "type": "integer" }, "from_cache": { "type": "boolean" } }, "required": ["seq", "kind", "url", "initiator", "status", "bytes", "ms", "from_cache"] } }, "next_seq": { "type": "integer" } }, "required": ["events", "next_seq"] }
    },

    "frame.diff": {
      "x-phase": "E5",
      "description": "Dommage du **dernier raster commis** (étape 252) : `{windowed, damage, items_prev, items_cur}`. `damage` = `{\"full\": true}` quand le repli plein cadre a été décidé (premier paint, borne d'items `DIRTY_DIFF_MAX_ITEMS` dépassée, ou diff qui couvre déjà toute la page), sinon `{\"full\": false, \"rects\": [...]}` — régions en px CSS document. `windowed: true` = chemin fenêtré (document au-dessus du cap viewport) : les rects rapportés sont le **vrai diff de listes** — la tranche viewport est repeinte entière par décision de raster, pas par manque de diff (un `full` systématique serait mensonger). `items_prev`/`items_cur` = tailles des display lists comparées. `null` avant le premier paint ou pendant une passe détachée.",
      "params": { "type": "object", "properties": { "tab": { "$ref": "#/$defs/tabId" } }, "required": ["tab"], "additionalProperties": false },
      "result": { "type": ["object", "null"], "properties": { "windowed": { "type": "boolean" }, "damage": { "type": "object", "properties": { "full": { "type": "boolean" }, "rects": { "type": "array", "items": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number" }, "height": { "type": "number" } }, "required": ["x", "y", "width", "height"] } } }, "required": ["full"] }, "items_prev": { "type": "integer" }, "items_cur": { "type": "integer" } } }
    },

    "engine.cascade": {
      "x-phase": "E5",
      "description": "Verdicts de cascade d'un élément par sa ref (étape 253 — consomme `StyleEngine::explain`, R-301) : `{node, declarations[]}` — une entrée par **déclaration × longhand** : `{prop, value, selector, sheet, origin, inline, rank, scope_rank, layer, specificity, order, verdict, inherited_from}`. `verdict` = `winner` | `{"eliminated_by": origin|scope|layer|specificity|order}` | `{"gated": pseudo|media|container|scope|mode}` | `dropped_validation` | `invalid_at_computed` | `superseded` | `presentational_hint` | `inherited` | `initial`. État **committé** : style parent lu sur la boîte posée, `containers` recalculés depuis l'arbre committé (un verdict `gated(container)` peut différer de la passe réelle si la bascule @container a déplacé le conteneur), pseudo-states tous faux comme au paint — vérité de cascade, pas post-animation. Hors borne : déclarations mortes au parse (`decl.malformed`), mutations en vol, pseudo-éléments. `stale_ref` si la ref a expiré, `engine_unavailable` avant la première navigation committée.",
      "params": { "type": "object", "properties": { "tab": { "$ref": "#/$defs/tabId" }, "ref": { "$ref": "#/$defs/elementRef" }, "props": { "type": "array", "items": { "type": "string" }, "description": "étape 257 — ne rendre que ces propriétés (noms déclarés)" }, "declared_only": { "type": "boolean", "default": false, "description": "étape 257 — true = omettre les verdicts initial/inherited (pas de déclaration candidate — ~200 traces de bruit)" } }, "required": ["tab", "ref"], "additionalProperties": false },
      "result": { "type": "object", "properties": { "node": { "type": "integer" }, "declarations": { "type": "array", "items": { "type": "object" } } }, "required": ["node", "declarations"] }
    },

    "describe": {
      "x-phase": "258-bis",
      "description": "Description complète d'un handle sans re-snapshot ni eval : `{node:{index,generation}, tag, attrs{}, rect, text, value?}`. `rect` = boîte commise en coords **document** (comme les rects du snapshot — soustraire `scroll_y` pour `click_at` viewport). `text` = `textContent` compacté plafonné à `max_text` (défaut 480). `value` présent seulement sur `input`/`textarea`/`select` (valeur courante — `textarea` = son texte, pas l'attribut). `stale_ref` si la ref a expiré ou le nœud a été réattribué.",
      "params": { "type": "object", "properties": { "tab": { "$ref": "#/$defs/tabId" }, "ref": { "$ref": "#/$defs/elementRef" }, "max_text": { "type": "integer", "minimum": 0 } }, "required": ["tab", "ref"], "additionalProperties": false },
      "result": { "type": "object", "properties": { "node": { "type": "object" }, "tag": { "type": "string" }, "attrs": { "type": "object" }, "rect": { "type": ["object", "null"] }, "text": { "type": "string" } }, "required": ["node", "tag", "attrs", "text"] }
    },

